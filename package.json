{
  "name": "abd-mission-control",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "build": "turbo run build",
    "dev": "set -a; [ ! -f .env ] || . ./.env; set +a; turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:e2e:phase2": "pnpm build && tsx --test tools/phase2.e2e.test.ts",
    "test:e2e:phase3": "pnpm build && tsx --test tools/phase3.e2e.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@types/node": "^22.15.0",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "drizzle-orm": "^0.41.0",
    "eslint": "^9.26.0",
    "postgres": "^3.4.9",
    "prettier": "^3.5.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsx": "^4.23.1",
    "turbo": "^2.5.3",
    "typescript": "^5.8.3",
    "vue-eslint-parser": "^10.1.3",
    "zod": "^3.25.76"
  }
}
