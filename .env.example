NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
API_URL=http://localhost:3001
API_CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
COLLECTOR_HOST=0.0.0.0
COLLECTOR_PORT=3003
COLLECTOR_URL=http://localhost:3003
DATABASE_URL=postgresql://mission_control:mission_control@localhost:5432/mission_control
NUXT_PUBLIC_API_BASE=http://localhost:3001
# Required before the API starts. This seeds the one and only owner account on first run.
AUTH_OWNER_EMAIL=you@example.com
AUTH_OWNER_PASSWORD=use-a-unique-password-of-at-least-16-characters
AUTH_SESSION_SECRET=use-a-random-secret-of-at-least-32-characters
STARLINK_HOST=192.168.100.1
STARLINK_PORT=9200
STARLINK_INTEGRATION_ID=00000000-0000-0000-0000-000000000001
STARLINK_POLL_INTERVAL_MS=30000
STARLINK_REQUEST_TIMEOUT_MS=5000
TELEMETRY_RETENTION_DAYS=30
EVENT_RETENTION_DAYS=90
RETENTION_CLEANUP_INTERVAL_MS=3600000
RETENTION_BATCH_SIZE=1000
